# ====================================================================
# MyBeautify Backend Environment Variables Template
# Copy this file to .env or configure in your deployment environment.
# Never commit real credentials or production secrets to Git.
# ====================================================================

# Application Server
PORT=8080
SPRING_PROFILE=default

# Database Configuration (Production MySQL)
DB_URL=jdbc:mysql://localhost:3306/Beautify?useSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DDL_AUTO=validate

# JWT Authentication
# Minimum 32 characters (256-bit) cryptographically random secret
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# E-Commerce Rates
CHECKOUT_TAX_RATE=0.08
CHECKOUT_SHIPPING=8.99

# Email Configuration (SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=no-reply@mybeautify.com
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Development Seeding (Only set true in development/test with SEED_DEFAULT_PASSWORD)
SEED_DATA=false
SEED_DEFAULT_PASSWORD=
