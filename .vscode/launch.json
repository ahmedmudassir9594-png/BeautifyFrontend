{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyBeautify Store (Run Without Debugging)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run-dev.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "MyBeautify Store (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/artifacts/mybeautify-store",
      "preLaunchTask": "Start MyBeautify Frontend"
    },
    {
      "name": "MyBeautify Store (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/artifacts/mybeautify-store",
      "preLaunchTask": "Start MyBeautify Frontend"
    }
  ]
}